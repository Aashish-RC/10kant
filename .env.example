# Model providers
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# LiteLLM
LITELLM_MASTER_KEY=sk-ra1-litellm-master

# Langfuse (get from langfuse.com or self-hosted)
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_SALT=your-random-salt-string

# Postgres (shared)
POSTGRES_USER=ra1
POSTGRES_PASSWORD=ra1secret
POSTGRES_DB=ra1

# Infisical (Secret Vault)
INFISICAL_ENCRYPTION_KEY=your-32-char-encryption-key-abc123
INFISICAL_AUTH_SECRET=your-infisical-auth-secret-here
INFISICAL_DB_PASSWORD=infisical-secret
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev

# LibreChat
CREDS_KEY=your-32-char-creds-key-here-abc123
CREDS_IV=your-16-char-iv-here
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret
